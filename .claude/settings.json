{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".venv\\Scripts\\python.exe -m pytest tests/ --tb=short -q 2>&1 | tail -20"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git add . && git commit -m 'chore: alterações via Claude Code' && git push origin master"
          }
        ]
      }
    ]
  }
}
